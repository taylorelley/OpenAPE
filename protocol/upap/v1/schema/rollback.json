{
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "upap/1",
      "title": "Protocol Version",
      "type": "string"
    },
    "version": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Version",
      "type": "string"
    },
    "reason": {
      "maxLength": 300,
      "minLength": 3,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "version",
    "reason"
  ],
  "title": "Rollback",
  "type": "object"
}
