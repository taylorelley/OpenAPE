{
  "$defs": {
    "Context": {
      "additionalProperties": false,
      "properties": {
        "task_type": {
          "default": "general",
          "enum": [
            "general",
            "code_review",
            "coding",
            "support",
            "creative",
            "research"
          ],
          "title": "Task Type",
          "type": "string"
        },
        "channel": {
          "default": "terminal",
          "enum": [
            "terminal",
            "chat",
            "voice",
            "background"
          ],
          "title": "Channel",
          "type": "string"
        },
        "stakes": {
          "default": "low",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Stakes",
          "type": "string"
        },
        "turn_origin": {
          "default": "user",
          "enum": [
            "user",
            "system",
            "tool",
            "subagent"
          ],
          "title": "Turn Origin",
          "type": "string"
        },
        "tags": {
          "items": {
            "enum": [
              "technical",
              "review",
              "sensitive",
              "urgent",
              "beginner",
              "expert"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Tags",
          "type": "array"
        }
      },
      "title": "Context",
      "type": "object"
    },
    "Host": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Adapter Version",
          "type": "string"
        },
        "host_version": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Host Version",
          "type": "string"
        },
        "provider_family": {
          "default": "other",
          "enum": [
            "openai",
            "anthropic",
            "google",
            "qwen",
            "other"
          ],
          "title": "Provider Family",
          "type": "string"
        },
        "model_id": {
          "default": "unspecified",
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Model Id",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "adapter_version",
        "host_version"
      ],
      "title": "Host",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Tenant Id",
          "type": "string"
        },
        "persona_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Persona Id",
          "type": "string"
        },
        "user_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "required": [
        "tenant_id",
        "persona_id"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Id",
          "type": "string"
        },
        "turn_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "turn_id"
      ],
      "title": "Session",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "upap/1",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Request Id",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/Identity"
    },
    "session": {
      "$ref": "#/$defs/Session"
    },
    "host": {
      "$ref": "#/$defs/Host"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "mode": {
      "default": "shadow",
      "enum": [
        "shadow",
        "active",
        "frozen"
      ],
      "title": "Mode",
      "type": "string"
    },
    "selection": {
      "default": "argmax",
      "enum": [
        "argmax",
        "sample"
      ],
      "title": "Selection",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "exploration_consent": {
      "default": false,
      "title": "Exploration Consent",
      "type": "boolean"
    },
    "pinned_version": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pinned Version"
    },
    "debug": {
      "default": false,
      "title": "Debug",
      "type": "boolean"
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "identity",
    "session",
    "host"
  ],
  "title": "Express",
  "type": "object"
}
