{
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "upap/1",
      "title": "Protocol Version",
      "type": "string"
    },
    "reflection_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Reflection Id",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Decision Id",
      "type": "string"
    },
    "adjustments": {
      "additionalProperties": {
        "enum": [
          "more",
          "less"
        ],
        "type": "string"
      },
      "maxProperties": 3,
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "directness",
          "warmth",
          "verbosity",
          "humour",
          "formality",
          "explanation_depth",
          "assertiveness"
        ]
      },
      "title": "Adjustments",
      "type": "object"
    },
    "reason": {
      "enum": [
        "user_requested",
        "user_corrected",
        "observed_preference"
      ],
      "title": "Reason",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "enum": [
            "core",
            "relationship"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    }
  },
  "required": [
    "protocol_version",
    "reflection_id",
    "decision_id",
    "adjustments",
    "reason"
  ],
  "title": "Reflection",
  "type": "object"
}
