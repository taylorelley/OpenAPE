{
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "upap/1",
      "title": "Protocol Version",
      "type": "string"
    },
    "persona_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Persona Id",
      "type": "string"
    },
    "seed_preferences": {
      "items": {
        "enum": [
          "concise",
          "detailed",
          "warm",
          "reserved",
          "formal",
          "casual",
          "direct",
          "gentle",
          "playful",
          "serious"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "title": "Seed Preferences",
      "type": "array"
    },
    "parent_persona_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Persona Id"
    }
  },
  "required": [
    "protocol_version",
    "persona_id"
  ],
  "title": "Create",
  "type": "object"
}
