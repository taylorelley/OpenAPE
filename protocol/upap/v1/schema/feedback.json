{
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "upap/1",
      "title": "Protocol Version",
      "type": "string"
    },
    "feedback_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Feedback Id",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Decision Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "explicit_user",
        "owner",
        "verified_evaluator",
        "agent_reflection"
      ],
      "title": "Source",
      "type": "string"
    },
    "kind": {
      "enum": [
        "rating",
        "pairwise_preference",
        "correction"
      ],
      "title": "Kind",
      "type": "string"
    },
    "actor_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Actor Id",
      "type": "string"
    },
    "consent_scope": {
      "default": "record_only",
      "enum": [
        "core",
        "relationship",
        "session",
        "record_only"
      ],
      "title": "Consent Scope",
      "type": "string"
    },
    "learning_consent": {
      "default": false,
      "title": "Learning Consent",
      "type": "boolean"
    },
    "value": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "preferred_control": {
      "anyOf": [
        {
          "maximum": 23,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Control"
    },
    "rejected_control": {
      "anyOf": [
        {
          "maximum": 23,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Control"
    },
    "evidence_group": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Evidence Group",
      "type": "string"
    },
    "occurred_at": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred At"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "feedback_id",
    "decision_id",
    "source",
    "kind",
    "actor_id",
    "evidence_group"
  ],
  "title": "Feedback",
  "type": "object"
}
