  "components": {
    "schemas": {
      "Consolidate": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "upap/1",
            "title": "Protocol Version"
          },
          "persona_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Persona Id"
          },
          "scope": {
            "type": "string",
            "enum": [
              "core",
              "relationship"
            ],
            "title": "Scope",
            "default": "relationship"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "protocol_version",
          "persona_id"
        ],
        "title": "Consolidate"
      },
      "Context": {
        "properties": {
          "task_type": {
            "type": "string",
            "enum": [
              "general",
              "code_review",
              "coding",
              "support",
              "creative",
              "research"
            ],
            "title": "Task Type",
            "default": "general"
          },
          "channel": {
            "type": "string",
            "enum": [
              "terminal",
              "chat",
              "voice",
              "background"
            ],
            "title": "Channel",
            "default": "terminal"
          },
          "stakes": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Stakes",
            "default": "low"
          },
          "turn_origin": {
            "type": "string",
            "enum": [
              "user",
              "system",
              "tool",
              "subagent"
            ],
            "title": "Turn Origin",
            "default": "user"
          },
          "tags": {
            "items": {
              "type": "string",
              "enum": [
                "technical",
                "review",
                "sensitive",
                "urgent",
                "beginner",
                "expert"
              ]
            },
            "type": "array",
            "maxItems": 6,
            "title": "Tags"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Context"
      },
      "Controls": {
        "properties": {
          "directness": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Directness"
          },
          "warmth": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Warmth"
          },
          "verbosity": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Verbosity"
          },
          "humour": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Humour"
          },
          "formality": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Formality"
          },
          "explanation_depth": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Explanation Depth"
          },
          "assertiveness": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ],
            "title": "Assertiveness"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "directness",
          "warmth",
          "verbosity",
          "humour",
          "formality",
          "explanation_depth",
          "assertiveness"
        ],
        "title": "Controls"
      },
      "Create": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "upap/1",
            "title": "Protocol Version"
          },
          "persona_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Persona Id"
          },
          "seed_preferences": {
            "items": {
              "type": "string",
              "enum": [
                "concise",
                "detailed",
                "warm",
                "reserved",
                "formal",
                "casual",
                "direct",
                "gentle",
                "playful",
                "serious"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "title": "Seed Preferences"
          },
          "parent_persona_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Persona Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "protocol_version",
          "persona_id"
        ],
        "title": "Create"
      },
      "Decision": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "upap/1",
            "title": "Protocol Version",
            "default": "upap/1"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Request Id"
          },
          "decision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Decision Id"
          },
          "persona_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Persona Version"
          },
          "relationship_version": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relationship Version"
          },
          "decoder_hash": {
            "type": "string",
            "title": "Decoder Hash"
          },
          "control_schema": {
            "type": "string",
            "const": "behaviour-controls/1",
            "title": "Control Schema",
            "default": "behaviour-controls/1"
          },
          "control_set_id": {
            "type": "string",
            "title": "Control Set Id"
          },
          "controls": {
            "$ref": "#/components/schemas/Controls"
          },
          "mode": {
            "type": "string",
            "enum": [
              "shadow",
              "active",
              "frozen"
            ],
            "title": "Mode"
          },
          "applies_to": {
            "type": "string",
            "const": "next_model_request",
            "title": "Applies To",
            "default": "next_model_request"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "cache_ttl_ms": {
            "type": "integer",
            "title": "Cache Ttl Ms",
            "default": 30000
          },
          "engine_status": {
            "type": "string",
            "enum": [
              "experimental_synthetic",
              "baseline_fallback"
            ],
            "title": "Engine Status"
          },
          "propensity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Propensity"
          },
          "diagnostics": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diagnostics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "decision_id",
          "persona_version",
          "decoder_hash",
          "control_set_id",
          "controls",
          "mode",
          "policy",
          "engine_status"
        ],
        "title": "Decision"
      },
      "Event": {
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Event Id"
          },
          "occurred_at": {
            "type": "string",
            "maxLength": 40,
            "title": "Occurred At"
          },
          "persona_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Persona Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "decision_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "session.started",
              "turn.preparing",
              "turn.completed",
              "turn.failed",
              "model.changed",
              "session.compacted",
              "session.ended",
              "tool.result.summary",
              "experience.corrected"
            ],
            "title": "Type"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "aborted"
            ],
            "title": "Status",
            "default": "ok"
          },
          "feedback_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "occurred_at",
          "persona_id",
          "type"
        ],
        "title": "Event"
      },
      "Export": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "upap/1",
            "title": "Protocol Version"
          },
          "include_relationships": {
            "type": "boolean",
            "title": "Include Relationships",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "protocol_version"
        ],
        "title": "Export"
      },
      "Express": {
        "properties": {
          "protocol_version": {
            "type": "string",
            "const": "upap/1",
            "title": "Protocol Version"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
            "title": "Request Id"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "host": {
