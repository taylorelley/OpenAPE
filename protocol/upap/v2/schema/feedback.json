{
  "$defs": {
    "Choice": {
      "additionalProperties": false,
      "description": "One rendered style: an approved trait configuration and its habits (catalogue order).",
      "properties": {
        "controls": {
          "$ref": "#/$defs/Controls"
        },
        "habits": {
          "items": {
            "enum": [
              "summary_first",
              "risks_first",
              "next_step",
              "confirm_goal",
              "clarify_once",
              "acknowledge_constraints",
              "concrete_examples",
              "analogies",
              "structured",
              "plain_words",
              "precise_terms",
              "tradeoffs",
              "acknowledge_progress",
              "light_aside",
              "recap_end",
              "flag_uncertainty"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Habits",
          "type": "array"
        }
      },
      "required": [
        "controls"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Controls": {
      "additionalProperties": false,
      "properties": {
        "directness": {
          "maximum": 4,
          "minimum": 0,
          "title": "Directness",
          "type": "integer"
        },
        "warmth": {
          "maximum": 4,
          "minimum": 0,
          "title": "Warmth",
          "type": "integer"
        },
        "verbosity": {
          "maximum": 4,
          "minimum": 0,
          "title": "Verbosity",
          "type": "integer"
        },
        "humour": {
          "maximum": 4,
          "minimum": 0,
          "title": "Humour",
          "type": "integer"
        },
        "formality": {
          "maximum": 4,
          "minimum": 0,
          "title": "Formality",
          "type": "integer"
        },
        "explanation_depth": {
          "maximum": 4,
          "minimum": 0,
          "title": "Explanation Depth",
          "type": "integer"
        },
        "assertiveness": {
          "maximum": 4,
          "minimum": 0,
          "title": "Assertiveness",
          "type": "integer"
        }
      },
      "required": [
        "directness",
        "warmth",
        "verbosity",
        "humour",
        "formality",
        "explanation_depth",
        "assertiveness"
      ],
      "title": "Controls",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "upap/2",
      "title": "Protocol Version",
      "type": "string"
    },
    "feedback_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Feedback Id",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Decision Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "explicit_user",
        "owner",
        "verified_evaluator",
        "agent_reflection"
      ],
      "title": "Source",
      "type": "string"
    },
    "kind": {
      "enum": [
        "rating",
        "pairwise_preference",
        "correction"
      ],
      "title": "Kind",
      "type": "string"
    },
    "actor_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Actor Id",
      "type": "string"
    },
    "consent_scope": {
      "default": "record_only",
      "enum": [
        "core",
        "relationship",
        "session",
        "record_only"
      ],
      "title": "Consent Scope",
      "type": "string"
    },
    "learning_consent": {
      "default": false,
      "title": "Learning Consent",
      "type": "boolean"
    },
    "value": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "preferred": {
      "anyOf": [
        {
          "$ref": "#/$defs/Choice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rejected": {
      "anyOf": [
        {
          "$ref": "#/$defs/Choice"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_group": {
      "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
      "title": "Evidence Group",
      "type": "string"
    },
    "occurred_at": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Occurred At"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]{1,100}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "protocol_version",
    "feedback_id",
    "decision_id",
    "source",
    "kind",
    "actor_id",
    "evidence_group"
  ],
  "title": "Feedback",
  "type": "object"
}
