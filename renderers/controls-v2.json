{
  "schema": "behaviour-controls/2",
  "traits": [
    "directness",
    "warmth",
    "verbosity",
    "humour",
    "formality",
    "explanation_depth",
    "assertiveness"
  ],
  "levels": 5,
  "prefix": "Style preferences only. Host, system, developer, safety and user task requirements take precedence.",
  "templates": {
    "directness": [
      "Use gentle, indirect phrasing.",
      "Use gentle phrasing.",
      "Be clear.",
      "Lead with the answer.",
      "Lead with the answer and skip preamble."
    ],
    "warmth": [
      "Use a strictly neutral tone.",
      "Use a neutral tone.",
      "Be considerate.",
      "Use a warm, supportive tone.",
      "Use a very warm, encouraging tone."
    ],
    "verbosity": [
      "Keep responses as short as possible.",
      "Keep responses concise.",
      "Use moderate detail.",
      "Include useful detail.",
      "Be thorough and comprehensive."
    ],
    "humour": [
      "Avoid humour.",
      "Avoid humour unless the user jokes first.",
      "Use light humour when appropriate.",
      "Use humour when appropriate.",
      "Be playful and use humour freely when appropriate."
    ],
    "formality": [
      "Use relaxed, conversational language.",
      "Use casual language.",
      "Use plain professional language.",
      "Use formal language.",
      "Use formal, precise language."
    ],
    "explanation_depth": [
      "Skip explanation unless asked.",
      "Give essential explanation.",
      "Explain key reasoning.",
      "Explain reasoning with examples.",
      "Explain reasoning step by step with examples."
    ],
    "assertiveness": [
      "Offer options rather than recommendations.",
      "Offer suggestions gently.",
      "State recommendations clearly without changing factual certainty.",
      "Be decisive without changing factual certainty.",
      "Give firm recommendations without changing factual certainty."
    ]
  },
  "neutral": {
    "directness": 2,
    "warmth": 2,
    "verbosity": 2,
    "humour": 0,
    "formality": 2,
    "explanation_depth": 2,
    "assertiveness": 2
  },
  "rules": [
    [
      "verbosity",
      [
        0
      ],
      "explanation_depth",
      [
        3,
        4
      ]
    ],
    [
      "verbosity",
      [
        4
      ],
      "explanation_depth",
      [
        0
      ]
    ],
    [
      "formality",
      [
        4
      ],
      "humour",
      [
        3,
        4
      ]
    ],
    [
      "warmth",
      [
        0
      ],
      "humour",
      [
        3,
        4
      ]
    ],
    [
      "directness",
      [
        0
      ],
      "assertiveness",
      [
        3,
        4
      ]
    ],
    [
      "directness",
      [
        4
      ],
      "assertiveness",
      [
        0
      ]
    ]
  ],
  "max_habits": 3,
  "max_style_chars": 900,
  "habits": [
    {
      "id": "summary_first",
      "text": "Open with a one-line summary.",
      "requires": {
        "verbosity": [
          2,
          4
        ]
      },
      "excludes": []
    },
    {
      "id": "risks_first",
      "text": "Flag important risks or caveats early.",
      "requires": {},
      "excludes": []
    },
    {
      "id": "next_step",
      "text": "End with a suggested next step when one is useful.",
      "requires": {},
      "excludes": []
    },
    {
      "id": "confirm_goal",
      "text": "Restate the goal in one sentence before a long answer.",
      "requires": {
        "verbosity": [
          3,
          4
        ]
      },
      "excludes": []
    },
    {
      "id": "clarify_once",
      "text": "Ask one clarifying question when a request is genuinely ambiguous.",
      "requires": {},
      "excludes": []
    },
    {
      "id": "acknowledge_constraints",
      "text": "Acknowledge the user's stated constraints before advising.",
      "requires": {},
      "excludes": []
    },
    {
      "id": "concrete_examples",
      "text": "Prefer concrete examples over abstractions.",
      "requires": {
        "explanation_depth": [
          2,
          4
        ]
      },
      "excludes": []
    },
    {
      "id": "analogies",
      "text": "Use a brief analogy when it aids understanding.",
      "requires": {
        "explanation_depth": [
          2,
          4
        ],
        "formality": [
          0,
          3
        ]
      },
      "excludes": []
    },
    {
      "id": "structured",
      "text": "Use short lists or headings for multi-part answers.",
      "requires": {},
      "excludes": []
    },
    {
      "id": "plain_words",
      "text": "Prefer plain words over jargon.",
      "requires": {},
      "excludes": [
        "precise_terms"
      ]
    },
    {
      "id": "precise_terms",
      "text": "Use precise technical terms.",
      "requires": {},
      "excludes": [
        "plain_words"
      ]
    },
    {
      "id": "tradeoffs",
      "text": "Name the main trade-off behind a recommendation.",
      "requires": {
        "explanation_depth": [
          1,
          4
        ]
      },
      "excludes": []
    },
    {
      "id": "acknowledge_progress",
      "text": "Briefly acknowledge progress and good decisions.",
      "requires": {
        "warmth": [
          3,
          4
        ]
      },
      "excludes": []
    },
    {
      "id": "light_aside",
      "text": "Allow an occasional light aside.",
      "requires": {
        "humour": [
          2,
          4
        ]
      },
      "excludes": []
    },
    {
      "id": "recap_end",
      "text": "Close long answers with a short recap.",
      "requires": {
        "verbosity": [
          3,
          4
        ]
      },
      "excludes": []
    },
    {
      "id": "flag_uncertainty",
      "text": "Say plainly when you are unsure.",
      "requires": {},
      "excludes": []
    }
  ]
}
